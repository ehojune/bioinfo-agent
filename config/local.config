/*
 * ============================================================================
 *  local.config — Nextflow configuration for THIS host.
 *  Repo: $BIOINFO_HOME/config/local.config   (= D:\bioinfo-agent\config\local.config)
 *
 *  Always passed as the LAST -c on every run:
 *
 *     nextflow run nf-core/<pipeline> -r <rev> \
 *        -profile docker \
 *        -c $BIOINFO_HOME/config/local.config \
 *        -c $BIOINFO_HOME/config/genomes.config \
 *        -work-dir $BIOINFO_WORK/<run-id> \
 *        --outdir  $BIOINFO_RUNS/<run-id>/results \
 *        -resume
 *
 *  PRECEDENCE WARNING — read this before you debug anything.
 *  A file supplied with -c is merged LAST and therefore BEATS everything set by
 *  -profile inside the pipeline's own nextflow.config. Concretely: the
 *  `docker { enabled = true }` block below will win even if you pass
 *  `-profile singularity`. There is exactly one place to change the container
 *  engine for this host and it is section 5 of this file.
 *
 *  Requires Nextflow >= 24.10.0. `process.resourceLimits` (section 2) does not
 *  exist in older releases and will abort the run with
 *  "Unknown process directive: resourceLimits". Check with `nextflow -version`.
 * ============================================================================
 */

// Timestamp fixed once per invocation; used to name the report/trace/timeline
// so that a -resume never collides with the files from the previous attempt.
def RUN_TS = new java.util.Date().format('yyyyMMdd-HHmmss')

// params.outdir is normally defined by the pipeline's own nextflow.config (and
// overridden by --outdir on the command line) before this file is merged.
// containsKey() is used deliberately: a bare `params.outdir` reference on an
// undefined key materialises an empty ConfigObject and that empty map then gets
// handed to the pipeline as the real value, which breaks schema validation.
def OUTDIR   = params.containsKey('outdir') && params.outdir ? params.outdir.toString() : 'results'
def INFO_DIR = "${OUTDIR}/pipeline_info"

// Per-host ceilings. Defaults are the values for this machine; override by
// exporting the variables from host.env before launching (see host.env.example).
// The '40.GB' / '24.h' spelling is the nf-core idiom and is what MemoryUnit and
// Duration parse; '40 GB' and '24h' also work. Do not write '40G'.
def MAX_CPUS     = (System.getenv('BIOINFO_MAX_CPUS') ?: '18') as Integer
def MAX_MEM_STR  = System.getenv('BIOINFO_MAX_MEMORY') ?: '40.GB'
def MAX_TIME_STR = System.getenv('BIOINFO_MAX_TIME')   ?: '24.h'
def MAX_MEM      = new nextflow.util.MemoryUnit(MAX_MEM_STR)
def MAX_TIME     = new nextflow.util.Duration(MAX_TIME_STR)


/* ============================================================================
 * 1. WHY THESE NUMBERS  (host budget)
 * ============================================================================
 *
 * Physical host:  24 logical cores, 63.5 GB RAM, Windows 11.
 * The pipeline does NOT run on the host. It runs inside the WSL2 VM, and the
 * VM has its own ceiling that Windows enforces. Three nested budgets:
 *
 *   host 63.5 GB / 24 cores
 *     └── WSL2 VM        52 GB / 22 cores     <- .wslconfig, see wslconfig.example
 *           └── Nextflow 40 GB / 18 cores     <- set in section 2, this file
 *
 *   Windows keeps 11.5 GB and 2 cores. That is not generosity: if Windows
 *   starts paging, the VM's disk I/O (which is a VHDX file on D:) collapses and
 *   the whole run slows down more than the memory was ever worth.
 *
 *   Inside the VM, 12 GB is held back from Nextflow for:
 *     ~8 GB  the Nextflow head JVM     (NXF_OPTS=-Xmx8g, set by 03-nextflow.sh)
 *     ~0.5 GB dockerd + containerd + systemd
 *     ~3.5 GB page cache / writeback slack for the ext4 VHDX. Linux will
 *            reclaim this, but a run with zero slack stalls on writeback.
 *
 *   Four cores held back so that `htop`, `docker stats` and an interactive shell
 *   inside the distro stay responsive while 18 cores are pinned.
 *
 * WSL2 DEFAULTS ARE WRONG FOR THIS BOX. Without a .wslconfig, WSL2 gives the VM
 * ~50% of host RAM (~31 GB here) — below the 40 GB Nextflow ceiling set here,
 * which means the Linux OOM killer, not Nextflow, decides which task dies. The
 * Nextflow ceiling MUST sit under the VM ceiling.
 *
 *   The .wslconfig to copy, with its traps and its measured results, is
 *   $BIOINFO_HOME/config/wslconfig.example — the only source for that file.
 */


/* ============================================================================
 * 2. EXECUTOR AND GLOBAL LIMITS
 * ============================================================================ */

executor {
    $local {
        // The scheduling pool. Nextflow will not start a task whose declared
        // cpus/memory would push the running total past these numbers.
        cpus      = MAX_CPUS
        memory    = MAX_MEM
        // Hard cap on concurrently running tasks. Even when every task is tiny,
        // 12 simultaneous docker containers is about where the VM's I/O and the
        // 18-core budget stop being the binding constraint.
        queueSize = 12
    }
    pollInterval    = '5 sec'
    queueStatInterval = '2 min'
}

process {
    executor = 'local'

    // resourceLimits clamps every task request to the host ceiling. This is what
    // makes the nf-core defaults (process_high = 72.GB, process_high_memory =
    // 200.GB) survive contact with a 40 GB box: they get silently reduced rather
    // than deadlocking the scheduler with a request that can never be satisfied.
    // Nextflow >= 24.04. Older pipelines instead read params.max_* (section 2b).
    resourceLimits = [ cpus: MAX_CPUS, memory: MAX_MEM, time: MAX_TIME ]

    // cache = 'lenient' — WSL-SPECIFIC AND IMPORTANT.
    // Input FASTQs and reference files often live on /mnt/d or /mnt/e, i.e. NTFS
    // via drvfs. drvfs reports unstable file timestamps, so the default (strict)
    // caching decides files have changed and re-runs tasks that -resume should
    // have skipped. 'lenient' hashes path + size + a coarse timestamp instead.
    cache = 'lenient'

    // scratch = false — the work dir is already on native ext4 (see NXF_WORK).
    // Setting scratch = true would copy inputs to /tmp and results back again,
    // doubling I/O for no gain.
    scratch = false

    /* --- error strategy ---------------------------------------------------
     * Retry only the exit codes that mean "died from the environment", never
     * the ones that mean "the tool disagreed with your data":
     *   104  transient I/O / connection reset (nf-core convention)
     *   134  SIGABRT  — glibc/JVM abort, usually allocation failure
     *   137  SIGKILL  — the Linux OOM killer. The characteristic WSL failure.
     *   139  SIGSEGV  — frequently memory exhaustion in C tools
     *   143  SIGTERM  — something asked the task to stop
     *   247  JVM heap exhaustion in some GATK/Picard builds
     * Anything else (1, 2, 255, tool-specific codes) is a real failure and must
     * surface immediately instead of burning three attempts.
     *
     * maxRetries = 2  -> at most 3 attempts per task. A retry only helps when
     * the next attempt differs, so it is tied to escalation. Where memory scales
     * with task.attempt (the labels below), retry. Where memory is a constant
     * because nothing is left to escalate into — process_high_memory,
     * STAR_GENOMEGENERATE, STAR_ALIGN — those blocks narrow errorStrategy to
     * [104, 143]: a memory death is final rather than three identical runs.
     *
     * 'finish' (not 'terminate') lets tasks already running complete, which
     * keeps the work dir consistent and makes the subsequent -resume cheap.
     */
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    /* --- resource labels --------------------------------------------------
     * nf-core label names, host-appropriate values. The nf-core base.config
     * numbers assume a cluster node; leaving them to be clamped by
     * resourceLimits works but wastes the scheduler's time, so they are
     * restated here against the real 18-core / 40 GB pool.
     *
     * Memory and time scale with task.attempt; cpus do NOT. Adding cores almost
     * never fixes a failed task and it does block the queue for everything else.
     * process_high_memory is the exception: its memory is already the whole pool,
     * so it is a constant and its retry set is narrowed to match.
     */
    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 30.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: process_high_memory {
        // 38 GB is effectively the whole pool: exactly one of these runs at a
        // time and everything else waits. That is intended — the alternative on
        // this box is the OOM killer.
        cpus            = 8
        memory          = { 38.GB }
        time            = { 20.h * task.attempt }
        containerOptions = '--ulimit nofile=8192:16384'
        // memory is a constant, not a ladder, so a retry cannot hand the task
        // more. Memory-exhaustion codes dropped from the retry set; 104 and 143
        // stay, because those are not about memory.
        errorStrategy   = { task.exitStatus in [104, 143] ? 'retry' : 'finish' }
    }
    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
}

/* --- 2b. legacy ceiling params ------------------------------------------
 * nf-core pipelines older than ~3.0 ignore resourceLimits and clamp through
 * their own check_max() against params.max_*. Setting both costs nothing and
 * means an older -r still respects this host.
 */
params {
    max_cpus   = MAX_CPUS
    max_memory = MAX_MEM_STR
    max_time   = MAX_TIME_STR
}


/* ============================================================================
 * 3. PER-PROCESS OVERRIDES
 * ============================================================================
 * Selectors are regexes matched against the fully qualified process name. If an
 * override appears not to fire, read the `process` column of the trace file from
 * the last run and match against that string — do not guess.
 * <!-- UNVERIFIED: process names below are the nf-core module names as of
 *      rnaseq 3.18.x / sarek 3.5.x; confirm against
 *      $OUTDIR/pipeline_info/execution_trace_*.txt after a -preview or stub run -->
 */
process {

    // Human STAR index generation peaks around 32-38 GB. It will not fit
    // alongside anything else on this box.
    withName: '.*STAR_GENOMEGENERATE.*' {
        cpus   = 12
        memory = { 38.GB }
        time   = 12.h
        // Constant memory, so no memory retry — see process_high_memory in section 2.
        errorStrategy = { task.exitStatus in [104, 143] ? 'retry' : 'finish' }
        // If it still OOMs, cap STAR's own allocator rather than raising memory:
        //   ext.args = '--limitGenomeGenerateRAM 34000000000'
        // WARNING: setting ext.args here REPLACES the pipeline's own ext.args for
        // this process. Copy the pipeline's value in first (nextflow config | grep).
    }

    // STAR holds the whole genome index in RAM per alignment job (~30 GB human).
    // Consequence on this host: STAR alignments are serialised, one sample at a
    // time. For cohorts above ~12 samples, pseudoalignment is the faster route:
    //   --pseudo_aligner salmon --skip_alignment
    // State that choice out loud in the run plan if you make it.
    withName: '.*STAR_ALIGN.*' {
        cpus   = 12
        memory = { 34.GB }
        time   = { 8.h * task.attempt }
        // Constant memory, so no memory retry — see process_high_memory in section 2.
        errorStrategy = { task.exitStatus in [104, 143] ? 'retry' : 'finish' }
    }

    // MultiQC's memory scales with sample count, not genome size.
    withName: '.*MULTIQC.*' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
    }

    // GATK/Picard tools are JVM processes: they need headroom above the heap the
    // module requests, otherwise the container is killed while the JVM still
    // believes it is within budget.
    // withName BEATS withLabel, so this SETS memory, it does not raise a floor.
    // A blanket '.*(GATK4|PICARD).*' selector therefore CUT the process_medium
    // (16 GB) and process_high (30 GB) ones — the duplicate markers and callers
    // that need it most. Scoped to the small JVM utilities instead. Add a name
    // here only after the trace shows that process running short.
    withName: '.*(GATK4_CREATESEQUENCEDICTIONARY|GATK4_INTERVALLISTTOOLS|PICARD_COLLECTMULTIPLEMETRICS).*' {
        memory = { 12.GB * task.attempt }
    }
}


/* ============================================================================
 * 4. OUTPUT STAGING
 * ============================================================================
 * nf-core exposes the publish mode as a param, which is the safe way to set it.
 * Do NOT set `process.publishDir` here: a top-level publishDir in a -c file
 * REPLACES the per-module publishDir blocks the pipeline defines in
 * conf/modules.config, and the output tree collapses into one flat directory.
 *
 * 'copy' rather than 'symlink': the work dir is on ext4 inside the VHDX and the
 * outdir may later be moved to /mnt/d or /mnt/e. A symlinked result set stops
 * resolving the moment it crosses that boundary, and is invisible to Windows
 * tools entirely. Copying costs disk; on a 955 GB volume that is the cheap side
 * of the trade.
 *
 * Once results are copied out and verified, the work dir is the thing that can
 * be deleted to reclaim space — deliberately, by run, never automatically.
 */
params {
    publish_dir_mode = 'copy'
}


/* ============================================================================
 * 5. CONTAINER ENGINE — the single place to change this for the host
 * ============================================================================ */

docker {
    enabled = true

    /* -u $(id -u):$(id -g)  — do not remove.
     * Without it every file the pipeline writes is owned by root:root inside the
     * work dir and the outdir. On WSL that is worse than on a normal Linux box:
     * the user cannot delete or even chown the results without sudo, and any
     * later attempt to copy them out to /mnt/d fails halfway.
     * Single quotes are required: $(id -u) must reach the generated
     * .command.run and be expanded by bash at task time, not by Groovy now.
     *
     * --shm-size=2g — the docker default /dev/shm is 64 MB, which is not enough
     * for anything using Python multiprocessing shared memory (scanpy, torch
     * dataloaders, parts of scrnaseq). Raise it here, globally; do NOT also set
     * --shm-size in a per-process containerOptions or docker gets the flag twice.
     */
    runOptions = '-u $(id -u):$(id -g) --shm-size=2g'

    // Gives each container a writable host-backed /tmp. Needed because running
    // as a non-existent uid leaves several images with an unwritable $HOME/$TMPDIR.
    temp = 'auto'

    // Fallback for images that insist on writing as root anyway: fixOwnership
    // chowns the outputs after the task. It requires chown inside the image, so
    // it breaks on distroless containers. Prefer runOptions above.
    fixOwnership = false

    // registry = 'quay.io'   // leave to the pipeline; overriding it here has
                              // broken image resolution for pipelines that pin
                              // a different registry.
}

// Stated explicitly so that two engines can never be enabled at once — that is a
// hard Nextflow error, and it is easy to trip by passing -profile singularity to
// a run that also loads this file.
singularity.enabled = false
apptainer.enabled   = false
conda.enabled       = false

// Known wart of the uid mapping: a few R/conda images resolve $HOME to a path
// that does not exist for the mapped uid and abort on startup. If you hit that,
// add the process to a withName block with:
//   containerOptions = '-e HOME=/tmp'
// rather than dropping the -u mapping.


/* ============================================================================
 * 6. REPORTING — on by default, written inside the run's own directory
 * ============================================================================
 * Everything lands in ${params.outdir}/pipeline_info/ so that a run directory is
 * self-describing: the results and the evidence of how they were produced travel
 * together. The trace file is the input to every future resource estimate — the
 * peak_rss column is how you find out what a process actually needed rather than
 * what the label claimed.
 */

report {
    enabled   = true
    file      = "${INFO_DIR}/execution_report_${RUN_TS}.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${INFO_DIR}/execution_timeline_${RUN_TS}.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${INFO_DIR}/execution_trace_${RUN_TS}.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,memory,time,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar,read_bytes,write_bytes'
    // Slim containers without procps report empty %cpu/rss. The task still runs;
    // only the metrics are missing.
}

dag {
    enabled   = true
    file      = "${INFO_DIR}/pipeline_dag_${RUN_TS}.html"
    overwrite = true
    // .html renders via bundled mermaid — no graphviz needed. Ask for .svg/.png
    // only if graphviz is installed in the distro.
}


/* ============================================================================
 * 7. WORK DIRECTORY AND CLEANUP GUARDRAILS
 * ============================================================================ */

// NEVER delete or clean the work directory.
// cleanup = true makes Nextflow remove the work dir on successful completion.
// That destroys -resume for every subsequent invocation, including the ones you
// have not thought of yet (adding a sample, re-running with a different caller,
// re-generating a report). Disk is cheap on this box: 955 GB free on the ext4
// VHDX. Reclaim space by deleting whole finished run directories deliberately,
// never by letting the framework do it behind your back.
cleanup = false

// The work dir MUST be native ext4. /mnt/d, /mnt/c and /mnt/e go through drvfs
// and are 5-10x slower for the small random writes Nextflow does constantly.
// Set it with -work-dir on the command line or NXF_WORK in host.env; this only
// warns, because failing the run here would be more annoying than informative.
// Tests the RESOLVED work dir, not NXF_WORK: -work-dir, the form the header of
// this file documents, never sets NXF_WORK, so an env-var guard cannot fire for
// the documented command. The elvis fallback is deliberate — an unresolvable
// workflow materialises as an empty ConfigObject, which is falsy, so the check
// degrades to the env var instead of throwing.
def WORK_DIR = "${workDir ?: (System.getenv('NXF_WORK') ?: '')}"
if (WORK_DIR.startsWith('/mnt/')) {
    System.err.println("[local.config] WARNING: work dir ${WORK_DIR} is on a Windows drive (drvfs). Expect a 5-10x slowdown. Move it to ext4.")
}


/* ============================================================================
 * 8. OPTIONAL PROFILES
 * ============================================================================
 * Additive: -profile docker,shared
 */
profiles {

    // Use when you need the machine back for other work. Halves the pool; the
    // run gets slower, the desktop stays usable.
    // Nested block form, not `executor.$local.cpus = 9` — a dotted path through a
    // $-prefixed name is read by Groovy as dynamic property access and does not
    // mean what it looks like.
    shared {
        executor {
            $local {
                cpus      = 9
                memory    = 20.GB
                queueSize = 6
            }
        }
        process {
            resourceLimits = [ cpus: 9, memory: 20.GB, time: MAX_TIME ]
        }
    }

    // Opt-in hard memory enforcement. By default the local executor treats
    // `memory` as a scheduling hint only — nothing stops a task from allocating
    // 50 GB and letting the kernel OOM-kill an unrelated process. This profile
    // converts each task's declared memory into a docker cgroup limit, so an
    // overshoot kills that container with 137 and the retry logic in section 2
    // gives it more memory on the next attempt — except in the constant-memory
    // blocks, where 137 is final by design.
    // Cost: a task that would have succeeded with a brief burst above its
    // declaration now fails once before succeeding. Worth it for unattended runs.
    strictmem {
        process {
            containerOptions = { "--memory=${task.memory.toMega()}m --memory-swap=${task.memory.toMega()}m" }

            // A selector beats the generic scope, so the containerOptions on
            // withLabel: process_high_memory (section 2) wins outright and the
            // line above never reaches the largest task on the box — the one
            // this profile exists to cap. Restate both together. Any other block
            // that grows a containerOptions needs the same treatment.
            withLabel: process_high_memory {
                containerOptions = { "--ulimit nofile=8192:16384 --memory=${task.memory.toMega()}m --memory-swap=${task.memory.toMega()}m" }
            }
        }
        // Check what resolved:
        //   nextflow config nf-core/rnaseq -profile docker,strictmem -flat | grep containerOptions
    }

    // Belt-and-braces for a stub/dry validation pass: tiny resources so the
    // scheduler never blocks, reporting still on.
    stubcheck {
        process {
            resourceLimits = [ cpus: 2, memory: 4.GB, time: 1.h ]
        }
        executor {
            $local { queueSize = 4 }
        }
    }
}


/* ============================================================================
 * 9. OPERATING RULES THIS FILE ASSUMES
 * ============================================================================
 *   - Validate with `-stub -profile docker,stubcheck` (or -preview) before any
 *     real execution. No exceptions.
 *   - Nothing estimated over 24 h starts without explicit user approval.
 *   - Refuse to start when free space on the work-dir filesystem is under
 *     1.5x the estimate: `df -h $NXF_WORK`.
 *   - Restart with -resume. Never silently re-run from scratch.
 *   - Never delete a work directory (see section 7).
 *   - QC verdicts only in the handoff. No biological interpretation.
 *
 * Verify what this file actually resolved to before trusting any of it:
 *   nextflow config nf-core/rnaseq -profile docker \
 *     -c $BIOINFO_HOME/config/local.config -flat | sort | less
 * ============================================================================
 */
