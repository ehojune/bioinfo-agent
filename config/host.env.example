# ============================================================================
#  host.env.example — everything that is true of THIS MACHINE and nothing else.
#
#  This is the only file you edit when you move to a different box. Copy it,
#  change the values, and every script and Nextflow config in the repo follows.
#
#      cp  $BIOINFO_HOME/config/host.env.example  $BIOINFO_HOME/config/host.env
#      $EDITOR $BIOINFO_HOME/config/host.env
#
#  Load it (the -a exports every assignment, which is what the configs expect):
#
#      set -a; . "$BIOINFO_HOME/config/host.env"; set +a
#
#  Add that line to ~/.bashrc inside the distro so interactive shells match what
#  the scripts see. host.env itself is per-machine and should not be committed.
#
#  Values below are this machine: Windows 11, 24 cores, 63.5 GB, C: 74 GB free,
#  D: 2.2 TB free, E: 3.7 TB free.
# ============================================================================


# ---- 1. identity of the box -------------------------------------------------

# WSL distro that runs pipelines. `wsl -l -v` from PowerShell lists them.
BIOINFO_DISTRO=Ubuntu-22.04

# Linux user that owns the work dirs, the refs store and the docker group.
BIOINFO_USER=ehojune

# Numeric uid 01-wsl-base.sh gives BIOINFO_USER when it creates the account. Default 1000,
# so file ownership lines up with the legacy distro's home archive. Uncomment to pin a
# different one; if the uid is already taken, 01 lets useradd auto-assign instead. Read
# only at user-creation time — 01 skips useradd once the user exists.
#BIOINFO_UID=1000

# Read-only archive distro holding the pre-existing environment (home, anaconda3).
# Pull scripts and old data FROM it. Never run a pipeline IN it.
BIOINFO_ARCHIVE_DISTRO=Ubuntu-legacy


# ---- 2. drives --------------------------------------------------------------
# Windows drive letters, as seen from inside WSL under /mnt/<lowercase letter>.
# C: is 74 GB free and must never be a target for anything a pipeline writes.

# Record only: nothing reads these two. 05-verify.sh checks /mnt/c /mnt/d /mnt/e directly,
# so changing them here changes no behaviour — they document the layout for a human.
BIOINFO_WIN_REPO_DRIVE=d      # /mnt/d — this repo, plus the reference sources
BIOINFO_WIN_DATA_DRIVE=e      # /mnt/e — 3.7 TB, bulk FASTQ / delivered results


# ---- 3. roots ---------------------------------------------------------------
# ext4 unless the comment says otherwise. ext4 means the distro's own filesystem,
# i.e. inside D:\wsl\ubuntu-24.04\ext4.vhdx (1 TB max, 955 GB free).
# /mnt/* is drvfs and is 5-10x slower for small random I/O.

# The repo. On NTFS on purpose: read-mostly, and editable from Windows.
BIOINFO_HOME=/mnt/d/bioinfo-agent

# Reference store root. ext4. Layout and contents defined by
# $BIOINFO_HOME/config/refs.manifest.tsv; materialised by bootstrap/04-refs.sh.
BIOINFO_REFS=/refs

# Nextflow work directories, one subdirectory per run. ext4, MANDATORY.
# Putting this on /mnt/* is the single most common way to make a run 10x slower.
# Never cleaned automatically — it is what -resume reads.
BIOINFO_WORK=/work

# Legacy ext4 results root, retained for existing host.env files. Do NOT point
# --outdir here: active results live under
# ${NXF_WORKROOT:-${BIOINFO_WORK:-/work}/nxf}/<run-id>/results and are copied
# to $BIOINFO_RUNLOG/<run-id>/results at handoff.
BIOINFO_RUNS=/runs

# Human-readable run record plus copied deliverables (plan, results, reports,
# QC verdict, handoff note). On NTFS so it is readable from Windows.
BIOINFO_RUNLOG=/mnt/d/bioinfo-agent/runs


# ---- 4. nextflow ------------------------------------------------------------
# bootstrap/03-nextflow.sh writes NXF_HOME, NXF_ASSETS, NXF_WORK, NXF_TEMP, the two
# container cache dirs, NXF_OPTS and NXF_SYNTAX_PARSER into ~/.config/bioinfo/env.sh, and
# THAT file wins at runtime: for those, the values here are the record of what this box
# uses, and changing one here without changing 03 changes nothing. Keep the two in step.
# NXF_ANSI_LOG and NXF_DISABLE_CHECK_LATEST are NOT written to env.sh — they reach a run
# only from this file (the ~/.bashrc sourcing line) or from the launch command, so
# changing those two here does take effect.

# Nextflow's own home: plugins, the run history db. 03-nextflow.sh sets $HOME/.nextflow.
# Written absolute because host.env is parsed, not sourced — $HOME does not expand.
NXF_HOME=/home/ehojune/.nextflow

# Where `nextflow pull` puts pipeline source. Read schema_input.json from here.
# NO /assets suffix: 03-nextflow.sh sets $BIOINFO_REFS/cache/nf-assets, and every
# schema-derivation command in the skill greps under this path. A wrong value here
# makes those commands return nothing instead of failing, which is worse.
NXF_ASSETS=/refs/cache/nf-assets

# Default work dir root. 03-nextflow.sh derives this as $BIOINFO_WORK/nextflow, so change
# BIOINFO_WORK rather than this line. Per run, the work dir is -work-dir $NXFDIR/work with
# NXFDIR=${NXF_WORKROOT:-${BIOINFO_WORK:-/work}/nxf}/<run-id> — the tree bin/preflight.sh
# sizes and gates. The older -work-dir $BIOINFO_WORK/<run-id> form is not gated; see the
# local.config header.
NXF_WORK=/work/nextflow

# Nextflow scratch/staging. ext4, not /mnt/*. Derived by 03 as $BIOINFO_WORK/tmp.
NXF_TEMP=/work/tmp

# Container image cache. Only used by apptainer/singularity; docker images live
# in /var/lib/docker, which is already on the ext4 VHDX and needs no relocation.
NXF_SINGULARITY_CACHEDIR=/refs/cache/containers
NXF_APPTAINER_CACHEDIR=/refs/cache/containers

# The Nextflow head JVM. This 8 GB is the largest single item in the 12 GB that
# local.config withholds from the task pool (52 GB VM - 40 GB pool) — see local.config §1.
# MUST be quoted: the value contains a space, and an unquoted value here is parsed as a
# command, which leaves NXF_OPTS unset rather than partially set.
NXF_OPTS="-Xms1g -Xmx8g"

# Plain log output. The ANSI progress display is unreadable when the run is
# started detached or its output is piped to a file.
NXF_ANSI_LOG=false

# Config parser generation. MUST be v1 on this host, for two independent reasons:
# the v2 parser rejects the top-level `def`-mixed-with-config-blocks style
# config/local.config uses, AND it rejects the check_max() function in nf-core
# pipelines' own template nextflow.config. v1 is still the Nextflow default, so
# leaving it unset happens to work today — pin it so the day the default flips,
# the failure is not "every run aborts at config-parse time" with no clue why.
# 03-nextflow.sh exports this; it was missing from this file, which is exactly
# the drift the header of this section warns about.
NXF_SYNTAX_PARSER=v1

# Nextflow version 03-nextflow.sh installs, and the integrity check on the installer.
# BIOINFO_NXF_SHA256 is EMPTY by default, and while it is empty the download is only
# sanity-checked (non-empty, is a shell script, launcher reports the pinned version) —
# it is NOT authenticated. get.nextflow.io publishes no digest, and this repo documents
# that host as one a middlebox may intercept (bootstrap/06-tls-trust.sh), so a rewritten
# installer could also serve a launcher that reports the right version.
# To close that: obtain the sha256 out of band, put it here, and 03 will enforce it.
#   sha256sum on a copy fetched from a network you trust, or a released asset digest
BIOINFO_NXF_VERSION=24.10.5
BIOINFO_NXF_SHA256=

# Suppress the phone-home version check on every invocation.
NXF_DISABLE_CHECK_LATEST=true

JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64


# ---- 5. ceilings ------------------------------------------------------------
# Three nested budgets: host > WSL VM > Nextflow. The Nextflow ceiling must sit
# UNDER the VM ceiling, or the Linux OOM killer decides which task dies instead
# of the scheduler. Full reasoning in local.config §1.

# Nextflow scheduling pool. Read by local.config.
BIOINFO_MAX_CPUS=18
BIOINFO_MAX_MEMORY=40.GB

# Guardrail, not a scheduler setting: anything estimated above this needs
# explicit user approval before it starts.
BIOINFO_MAX_TIME=24.h

# What the VM itself is given, in C:\Users\admin\.wslconfig. Recorded here so a
# mismatch is visible in one place; changing these values does NOT change the VM
# — edit .wslconfig and run `wsl --shutdown`. Sample file: config/wslconfig.example.
BIOINFO_WSL_VM_CPUS=22
BIOINFO_WSL_VM_MEM=52GB

# Sanity check after any change (inside the distro):
#   nproc     -> should equal BIOINFO_WSL_VM_CPUS
#   free -g   -> total should be ~1 GB under BIOINFO_WSL_VM_MEM


# ---- 6. containers ----------------------------------------------------------

# Record only: the container profile this repo standardises on. Docker *engine* inside the
# distro, not Docker Desktop. No script or doc composes a command from this — run commands
# spell out `-profile docker`, and bin/preflight.sh greps for that literal. Changing it here
# is not enough either way: local.config §5 hard-sets docker.enabled and, being the last -c,
# overrides any -profile. Change the launch command, local.config and preflight together.
BIOINFO_CONTAINER_PROFILE=docker

# Non-root uid/gid mapping for containers is handled by docker.runOptions in
# local.config §5. Without it every output file is owned by root and cannot be
# copied out to /mnt/d. There is no env var for it; do not remove it there.
