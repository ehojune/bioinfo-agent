# ============================================================================
#  host.env.example — everything that is true of THIS MACHINE and nothing else.
#
#  This is the only file you edit when you move to a different box. Copy it,
#  change the values, and every script and Nextflow config in the repo follows.
#
#      cp  $BIOINFO_HOME/config/host.env.example  $BIOINFO_HOME/config/host.env
#      $EDITOR $BIOINFO_HOME/config/host.env
#
#  Load it (the -a exports every assignment, which is what the configs expect):
#
#      set -a; . "$BIOINFO_HOME/config/host.env"; set +a
#
#  Add that line to ~/.bashrc inside the distro so interactive shells match what
#  the scripts see. host.env itself is per-machine and should not be committed.
#
#  Values below are this machine: Windows 11, 24 cores, 63.5 GB, C: 74 GB free,
#  D: 2.2 TB free, E: 3.7 TB free.
# ============================================================================


# ---- 1. identity of the box -------------------------------------------------

# WSL distro that runs pipelines. `wsl -l -v` from PowerShell lists them.
BIOINFO_DISTRO=Ubuntu-24.04

# Linux user that owns the work dirs, the refs store and the docker group.
BIOINFO_USER=ehojune

# Read-only archive distro holding the pre-existing environment (home, anaconda3).
# Pull scripts and old data FROM it. Never run a pipeline IN it.
BIOINFO_ARCHIVE_DISTRO=Ubuntu-legacy


# ---- 2. drives --------------------------------------------------------------
# Windows drive letters, as seen from inside WSL under /mnt/<lowercase letter>.
# C: is 74 GB free and must never be a target for anything a pipeline writes.

BIOINFO_WIN_REPO_DRIVE=d      # /mnt/d — this repo, plus the reference sources
BIOINFO_WIN_DATA_DRIVE=e      # /mnt/e — 3.7 TB, bulk FASTQ / delivered results


# ---- 3. roots ---------------------------------------------------------------
# ext4 unless the comment says otherwise. ext4 means the distro's own filesystem,
# i.e. inside D:\wsl\ubuntu-24.04\ext4.vhdx (1 TB max, 955 GB free).
# /mnt/* is drvfs and is 5-10x slower for small random I/O.

# The repo. On NTFS on purpose: read-mostly, and editable from Windows.
BIOINFO_HOME=/mnt/d/bioinfo

# Reference store root. ext4. Layout and contents defined by
# $BIOINFO_HOME/config/refs.manifest.tsv; materialised by bootstrap/04-refs.sh.
BIOINFO_REFS=/refs

# Nextflow work directories, one subdirectory per run. ext4, MANDATORY.
# Putting this on /mnt/* is the single most common way to make a run 10x slower.
# Never cleaned automatically — it is what -resume reads.
BIOINFO_WORK=/work

# Pipeline outdirs, one subdirectory per run. ext4 while the run is live; copy
# or move finished results out to /mnt/e for long-term storage.
BIOINFO_RUNS=/runs

# Human-readable run record (plan, decisions, QC verdict, handoff note).
# On NTFS so it is readable from Windows without launching the distro.
# Distinct from BIOINFO_RUNS, which holds the actual data.
BIOINFO_RUNLOG=/mnt/d/bioinfo/runs


# ---- 4. nextflow ------------------------------------------------------------

# Nextflow's own home: cached pipeline assets, plugins, the run history db.
# Sits inside the reference-store cache tree by the reference store standard.
NXF_HOME=/refs/cache/nf-assets

# Where `nextflow pull` puts pipeline source. Read schema_input.json from here.
NXF_ASSETS=/refs/cache/nf-assets/assets

# Default work dir. Override per run with -work-dir $BIOINFO_WORK/<run-id>.
NXF_WORK=/work

# Nextflow scratch/staging. ext4, not /mnt/*.
NXF_TEMP=/var/tmp/nxf

# Container image cache. Only used by apptainer/singularity; docker images live
# in /var/lib/docker, which is already on the ext4 VHDX and needs no relocation.
NXF_SINGULARITY_CACHEDIR=/refs/cache/containers
NXF_APPTAINER_CACHEDIR=/refs/cache/containers

# The Nextflow JVM. This 4 GB is counted against the 8 GB of VM memory that
# local.config deliberately withholds from the task pool — see local.config §1.
NXF_OPTS=-Xms512m -Xmx4g

# Plain log output. The ANSI progress display is unreadable when the run is
# started detached or its output is piped to a file.
NXF_ANSI_LOG=false

# Suppress the phone-home version check on every invocation.
NXF_DISABLE_CHECK_LATEST=true

JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64


# ---- 5. ceilings ------------------------------------------------------------
# Three nested budgets: host > WSL VM > Nextflow. The Nextflow ceiling must sit
# UNDER the VM ceiling, or the Linux OOM killer decides which task dies instead
# of the scheduler. Full reasoning in local.config §1.

# Nextflow scheduling pool. Read by local.config.
BIOINFO_MAX_CPUS=18
BIOINFO_MAX_MEMORY=40.GB

# Guardrail, not a scheduler setting: anything estimated above this needs
# explicit user approval before it starts.
BIOINFO_MAX_TIME=24.h

# What the VM itself is given, in C:\Users\admin\.wslconfig. Recorded here so a
# mismatch is visible in one place; changing these values does NOT change the VM
# — edit .wslconfig and run `wsl --shutdown`. Sample file in local.config §1.
BIOINFO_WSL_VM_CPUS=20
BIOINFO_WSL_VM_MEM=48GB

# Sanity check after any change (inside the distro):
#   nproc     -> should equal BIOINFO_WSL_VM_CPUS
#   free -g   -> total should be ~1 GB under BIOINFO_WSL_VM_MEM


# ---- 6. containers ----------------------------------------------------------

# The -profile value every run uses. Docker *engine* inside the distro, not
# Docker Desktop. Changing this alone is not enough: local.config §5 hard-sets
# docker.enabled and, being the last -c, overrides any -profile. Change both.
BIOINFO_CONTAINER_PROFILE=docker

# Non-root uid/gid mapping for containers is handled by docker.runOptions in
# local.config §5. Without it every output file is owned by root and cannot be
# copied out to /mnt/d. There is no env var for it; do not remove it there.
