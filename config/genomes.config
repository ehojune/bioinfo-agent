/*
 * ============================================================================
 *  genomes.config — the reference store, expressed as Nextflow params.
 *  Repo: $BIOINFO_HOME/config/genomes.config
 *
 *  Purpose: a pipeline invocation must never contain a source filename. Not
 *  hg38.fa, not Homo_sapiens_assembly38_noALT_noHLA_noDecoy.fasta. Only
 *  standard paths under $BIOINFO_REFS, which config/refs.manifest.tsv defines
 *  and bootstrap/04-refs.sh materialises.
 *
 *  Loaded after local.config:
 *     -c $BIOINFO_HOME/config/local.config \
 *     -c $BIOINFO_HOME/config/genomes.config
 *
 *  THIS FILE IS AHEAD OF THE FILESYSTEM.
 *  Every path is declared whether or not it exists yet. Entries marked  [!]  are
 *  known-missing as of the manifest: sequence dictionaries, all built indexes
 *  (STAR / salmon / bismark), the GATK resource bundle, and the VEP/snpEff
 *  caches. Declaring them means the config does not have to change when they
 *  appear; it does NOT mean they are there.
 *
 *      The filesystem is the truth, and 04-refs.sh reports it:
 *          bash $BIOINFO_HOME/bootstrap/04-refs.sh --check
 *      Run that before building a run plan. Never infer availability from here.
 *
 *  Param names below were written against nf-core/rnaseq 3.18.x and
 *  nf-core/sarek 3.5.x. They drift between releases. Re-derive before first use
 *  on a revision you have not run here before — commands in section 4.
 * ============================================================================
 */

// Root of the reference store. Native ext4; see the reference store standard.
// A local def rather than a bare params reference so that the genomes map below
// does not depend on evaluation order inside the params block.
def REFS = System.getenv('BIOINFO_REFS') ?: '/refs'


/* ============================================================================
 * 1. PARAMS
 * ============================================================================ */

params {

    // Exposed so a pipeline invocation or a downstream config can interpolate it.
    // Note: nf-schema will list `refs` under "unrecognised parameters" for every
    // pipeline, because it is ours and not theirs. That warning is expected and
    // harmless. To silence it, see section 5.
    refs = REFS

    // Where nf-core would look for AWS iGenomes if it were allowed to. Pointed at
    // the local cache so an accidental resolution stays on this machine instead of
    // starting a multi-hundred-GB S3 download.
    igenomes_base = "${REFS}/cache/igenomes"

    /* ------------------------------------------------------------------------
     * genomes map — iGenomes-shaped, so `--genome <key>` resolves through the
     * pipeline's own getGenomeAttribute(). Keys that a given pipeline does not
     * know about are simply never read.
     *
     * Legend:   (ok)  present on disk per refs.manifest.tsv
     *           [!]   declared here, NOT on disk yet — build or fetch required
     * ---------------------------------------------------------------------- */
    genomes {

        /* -------------------------------------------------------------- GRCh38
         * UCSC-style hg38 (chr-prefixed) + GENCODE v50.
         * The transcriptomics build. Use for rnaseq, methylseq, atacseq,
         * chipseq, cutandrun, scrnaseq.
         */
        'GRCh38' {
            fasta            = "${REFS}/genomes/GRCh38/fasta/genome.fa"            // (ok) link -> hg38.fa
            fasta_fai        = "${REFS}/genomes/GRCh38/fasta/genome.fa.fai"        // (ok)
            fai              = "${REFS}/genomes/GRCh38/fasta/genome.fa.fai"        // (ok) alias; some pipelines read `fai`
            dict             = "${REFS}/genomes/GRCh38/fasta/genome.dict"          // [!] build: gatk CreateSequenceDictionary

            gtf              = "${REFS}/genomes/GRCh38/gtf/genes.gtf.gz"           // (ok) GENCODE v50, gzip is accepted
            gene_bed         = "${REFS}/genomes/GRCh38/bed/genes.bed"              // (ok) rnaseq calls this gene_bed
            bed              = "${REFS}/genomes/GRCh38/bed/genes.bed"              // (ok) alias for pipelines using `bed`

            star             = "${REFS}/genomes/GRCh38/index/star"                 // [!] build (~1 h, needs ~38 GB)
            star_index       = "${REFS}/genomes/GRCh38/index/star"                 // [!] rnaseq param name
            salmon           = "${REFS}/genomes/GRCh38/index/salmon"               // [!] build
            salmon_index     = "${REFS}/genomes/GRCh38/index/salmon"               // [!] rnaseq param name
            bismark_index    = "${REFS}/genomes/GRCh38/index/bismark"              // [!] build, methylseq only
            bowtie2          = "${REFS}/genomes/GRCh38/index/bowtie2"              // [!] build, atacseq/chipseq/cutandrun
            bwa              = "${REFS}/genomes/GRCh38/index/bwa"                  // [!] not built for this build; the BWA
                                                                                   //     index we own belongs to GRCh38gatk
            // transcript_fasta is derived by rnaseq from fasta+gtf when absent.
            // Leave it undeclared rather than pointing at a file we do not have.
        }

        /* ---------------------------------------------------------- GRCh38gatk
         * GATK analysis set: no ALT, no HLA, no decoy, already BWA-indexed.
         * This is the build sarek should use. Contig names are chr-prefixed and
         * match GENCODE, but the contig SET is smaller than GRCh38 above — never
         * mix a BAM aligned to one with a reference from the other.
         *
         * The BWA index files were copied (not linked) into index/bwa/ as
         * genome.fa.{amb,ann,bwt,pac,sa}. That renaming is load-bearing: bwa
         * derives the index prefix from the fasta basename, so index prefix and
         * fasta basename must agree. This is the whole reason the manifest
         * normalises filenames.
         */
        'GRCh38gatk' {
            fasta               = "${REFS}/genomes/GRCh38gatk/fasta/genome.fa"      // (ok) link
            fasta_fai           = "${REFS}/genomes/GRCh38gatk/fasta/genome.fa.fai"  // (ok)
            fai                 = "${REFS}/genomes/GRCh38gatk/fasta/genome.fa.fai"  // (ok) alias
            dict                = "${REFS}/genomes/GRCh38gatk/fasta/genome.dict"    // [!] build: gatk CreateSequenceDictionary

            bwa                 = "${REFS}/genomes/GRCh38gatk/index/bwa"            // (ok) directory, copied to ext4
            bwamem2             = "${REFS}/genomes/GRCh38gatk/index/bwamem2"        // [!] different index format, must be rebuilt
            dragmap             = "${REFS}/genomes/GRCh38gatk/index/dragmap"        // [!]

            // GATK resource bundle. None of this is on disk. Without dbsnp and
            // known_indels you cannot run BQSR — pass --skip_tools baserecalibrator
            // and say so in the run plan rather than quietly producing
            // un-recalibrated BAMs.
            dbsnp               = "${REFS}/genomes/GRCh38gatk/gatkbundle/dbsnp.vcf.gz"               // [!] fetch
            dbsnp_tbi           = "${REFS}/genomes/GRCh38gatk/gatkbundle/dbsnp.vcf.gz.tbi"           // [!] fetch
            known_indels        = "${REFS}/genomes/GRCh38gatk/gatkbundle/known_indels.vcf.gz"        // [!] fetch
            known_indels_tbi    = "${REFS}/genomes/GRCh38gatk/gatkbundle/known_indels.vcf.gz.tbi"    // [!] fetch
            germline_resource     = "${REFS}/genomes/GRCh38gatk/gatkbundle/germline_resource.vcf.gz"     // [!] fetch, gnomAD af-only, mutect2 only
            germline_resource_tbi = "${REFS}/genomes/GRCh38gatk/gatkbundle/germline_resource.vcf.gz.tbi" // [!] fetch

            // Annotation. sarek reads these when --tools includes vep / snpeff.
            vep_cache           = "${REFS}/cache/vep"                                // [!] fetch, ~25 GB
            snpeff_cache        = "${REFS}/cache/snpeff"                             // [!] fetch
            // vep_genome / vep_species / vep_cache_version / snpeff_db are
            // sarek-version-specific strings, not paths. Set them on the command
            // line for the revision you are running.
            // <!-- UNVERIFIED: exact key names; confirm via
            //      cat $NXF_ASSETS/.repos/nf-core/sarek/clones/*/conf/igenomes.config -->

            // intervals: sarek derives WGS calling intervals from the .fai when
            // none is given. Only declare a file here for targeted/WES panels.
            // intervals        = "${REFS}/genomes/GRCh38gatk/bed/targets.bed"       // [!] per-assay, not a shared reference

            // No GTF/BED for this build. GENCODE v50 uses the same chr-prefixed
            // names, so genomes.GRCh38.gtf is usable for annotation-only steps,
            // but it references contigs this FASTA does not contain. Do not wire
            // it in silently — if you need it, pass it explicitly and note it.
        }

        /* -------------------------------------------------------------- KOREF1
         * Korean reference assembly. Bare FASTA only — no index, no dict, no
         * annotation. Nothing in the stocked nf-core set will run end to end on
         * this build until at least .fai + .dict + an aligner index exist.
         * Treat it as a comparison reference, not a pipeline target, for now.
         */
        'KOREF1' {
            fasta            = "${REFS}/genomes/KOREF1/fasta/genome.fa"             // (ok) link
            fasta_fai        = "${REFS}/genomes/KOREF1/fasta/genome.fa.fai"         // [!] build: samtools faidx
            fai              = "${REFS}/genomes/KOREF1/fasta/genome.fa.fai"         // [!]
            dict             = "${REFS}/genomes/KOREF1/fasta/genome.dict"           // [!] build
            bwa              = "${REFS}/genomes/KOREF1/index/bwa"                   // [!] build, ~1.5 h
            // chrY ships as a separate FASTA. Not an nf-core param — no pipeline
            // will pick this up automatically; it is here so the path is recorded.
            chry_fasta       = "${REFS}/genomes/KOREF1/fasta/chrY.fa"               // (ok) link, non-standard key
        }
    }
}

/* ============================================================================
 * 1b. STR / REPEAT CATALOGS
 * ============================================================================
 * Not part of any stocked nf-core pipeline — ExpansionHunter, TRGT and HipSTR
 * are driven directly. Recorded here so the standard paths are in one place and
 * a wrapper script can source them instead of hardcoding /mnt/d filenames.
 * All (ok): linked by the manifest.
 *
 *   $BIOINFO_REFS/catalogs/str/hipstr.GRCh38.bed
 *   $BIOINFO_REFS/catalogs/str/trgt_repeats.GRCh38.bed
 *   $BIOINFO_REFS/catalogs/str/trgt_pathogenic.GRCh38.bed
 *   $BIOINFO_REFS/catalogs/str/eh_catalog.GRCh38.json
 *   $BIOINFO_REFS/catalogs/str/eh_catalog.disease.GRCh38.json
 *
 * These are GRCh38 coordinates. Pair them with genomes.GRCh38, or with
 * GRCh38gatk only after confirming the loci are on primary contigs.
 */


/* ============================================================================
 * 2. HOW A PIPELINE CONSUMES THIS — nf-core/rnaseq
 * ============================================================================
 *
 * Two forms. Prefer the explicit one.
 *
 * -- (a) via --genome, the compact form -----------------------------------
 *
 *   nextflow run nf-core/rnaseq -r 3.18.0 \
 *     -profile docker \
 *     -c $BIOINFO_HOME/config/local.config \
 *     -c $BIOINFO_HOME/config/genomes.config \
 *     --igenomes_ignore \
 *     --genome GRCh38 \
 *     --input   $BIOINFO_RUNS/<run-id>/samplesheet.csv \
 *     --outdir  $BIOINFO_RUNS/<run-id>/results \
 *     --save_reference \
 *     -work-dir $BIOINFO_WORK/<run-id> \
 *     -resume
 *
 *   --igenomes_ignore MUST be on the COMMAND LINE, not in a -c file. The
 *   pipeline's own nextflow.config decides whether to include conf/igenomes.config
 *   at parse time, which happens before any -c file is merged. Setting
 *   params.igenomes_ignore here would be a no-op for that include.
 *   Verify:  nextflow config nf-core/rnaseq -profile docker -flat | grep -c '^params.genomes.GRCh37'
 *            (a nonzero count means iGenomes leaked in)
 *
 * -- (b) explicit paths, the robust form ----------------------------------
 *   Survives --genome semantics changing between releases, and makes the run
 *   command self-documenting. Still contains no source filenames.
 *
 *     --fasta        $BIOINFO_REFS/genomes/GRCh38/fasta/genome.fa \
 *     --gtf          $BIOINFO_REFS/genomes/GRCh38/gtf/genes.gtf.gz \
 *     --gene_bed     $BIOINFO_REFS/genomes/GRCh38/bed/genes.bed \
 *     --star_index   $BIOINFO_REFS/genomes/GRCh38/index/star \
 *     --salmon_index $BIOINFO_REFS/genomes/GRCh38/index/salmon
 *
 * -- first run on this host -------------------------------------------------
 *   The STAR and salmon indexes do not exist [!]. Omit --star_index and
 *   --salmon_index, add --save_reference, and the pipeline builds them into
 *   <outdir>/genome/index/. Then move them into the reference store so the next
 *   run does not rebuild:
 *
 *     mv <outdir>/genome/index/star   $BIOINFO_REFS/genomes/GRCh38/index/star
 *     mv <outdir>/genome/index/salmon $BIOINFO_REFS/genomes/GRCh38/index/salmon
 *
 *   Budget ~1 h and ~38 GB peak for STAR on this box (see local.config §3);
 *   nothing else runs while it builds.
 */


/* ============================================================================
 * 3. HOW A PIPELINE CONSUMES THIS — nf-core/sarek
 * ============================================================================
 *
 *   nextflow run nf-core/sarek -r 3.5.1 \
 *     -profile docker \
 *     -c $BIOINFO_HOME/config/local.config \
 *     -c $BIOINFO_HOME/config/genomes.config \
 *     --igenomes_ignore \
 *     --genome GRCh38gatk \
 *     --input   $BIOINFO_RUNS/<run-id>/samplesheet.csv \
 *     --outdir  $BIOINFO_RUNS/<run-id>/results \
 *     --tools   haplotypecaller \
 *     --skip_tools baserecalibrator \
 *     -work-dir $BIOINFO_WORK/<run-id> \
 *     -resume
 *
 *   Explicit form:
 *     --fasta      $BIOINFO_REFS/genomes/GRCh38gatk/fasta/genome.fa \
 *     --fasta_fai  $BIOINFO_REFS/genomes/GRCh38gatk/fasta/genome.fa.fai \
 *     --dict       $BIOINFO_REFS/genomes/GRCh38gatk/fasta/genome.dict \
 *     --bwa        $BIOINFO_REFS/genomes/GRCh38gatk/index/bwa
 *
 *   TWO BLOCKERS, both real, both currently true on this host:
 *
 *   1. genome.dict does not exist [!]. GATK will not start without it. One-off:
 *        gatk CreateSequenceDictionary \
 *          -R $BIOINFO_REFS/genomes/GRCh38gatk/fasta/genome.fa \
 *          -O $BIOINFO_REFS/genomes/GRCh38gatk/fasta/genome.dict
 *      Note the .dict must sit beside the FASTA and be named genome.dict
 *      (basename of the FASTA with .dict), which the standard layout already does.
 *
 *   2. The GATK resource bundle is absent [!]. dbsnp and known_indels are
 *      required by BaseRecalibrator. Until they are fetched, either
 *      --skip_tools baserecalibrator (and record that the BAMs are not
 *      recalibrated) or fetch the bundle first. Do not substitute a different
 *      dbsnp build to make the error go away.
 *
 *   --sarek's `bwa` param takes the DIRECTORY, not a file prefix. The index
 *   inside must be named after the FASTA basename (genome.fa.*), which the
 *   manifest guarantees.
 *   <!-- UNVERIFIED: sarek param spelling (--bwa vs --bwa_index) has changed
 *        across 3.x; confirm with `nextflow run nf-core/sarek -r <rev> --help` -->
 */


/* ============================================================================
 * 4. RE-DERIVE BEFORE YOU TRUST ANY OF THE ABOVE
 * ============================================================================
 * Param and samplesheet schemas drift between revisions. For a revision you have
 * not run on this host before, run all four:
 *
 *   # every param this revision accepts, with its default
 *   nextflow run nf-core/<pipeline> -r <rev> --help
 *
 *   # the samplesheet columns, authoritative
 *   cat $NXF_ASSETS/.repos/nf-core/<pipeline>/clones/*/assets/schema_input.json
 *
 *   # the reference keys this revision reads out of params.genomes
 *   grep -n 'getGenomeAttribute' -r $NXF_ASSETS/.repos/nf-core/<pipeline>/clones/*
 *   cat $NXF_ASSETS/.repos/nf-core/<pipeline>/clones/*/conf/igenomes.config
 *
 *   # what the merged config ACTUALLY resolved to, this file included
 *   nextflow config nf-core/<pipeline> -profile docker \
 *     -c $BIOINFO_HOME/config/local.config \
 *     -c $BIOINFO_HOME/config/genomes.config -flat | grep '^params.genomes'
 *
 * `nextflow config` uses the revision currently cached under $NXF_ASSETS, so
 * `nextflow pull nf-core/<pipeline> -r <rev>` first if you are pinning.
 *
 * And before any of it, confirm the files exist:
 *   bash $BIOINFO_HOME/bootstrap/04-refs.sh --check
 */


/* ============================================================================
 * 5. THE "unrecognised parameter" WARNING
 * ============================================================================
 * `params.refs` is not a param any nf-core pipeline declares, so schema
 * validation lists it as unrecognised. It is a warning, not an error, and the
 * run proceeds. To silence it, add ONE of these depending on the validation
 * plugin the revision uses:
 *
 *   // nf-core 2.x  (nf-validation)
 *   // params.validationSchemaIgnoreParams = 'refs'
 *
 *   // nf-core 3.x  (nf-schema)
 *   // validation { ignoreParams = ['refs'] }
 *
 * <!-- UNVERIFIED: exact config scope/key for nf-schema; confirm with
 *      `nextflow config nf-core/<pipeline> -flat | grep -i validation` -->
 *
 * Never set failUnrecognisedParams = false to hide a genuine typo in a real
 * pipeline param — that warning is the only thing standing between you and a
 * six-hour run against a default you did not mean to accept.
 * ============================================================================
 */
