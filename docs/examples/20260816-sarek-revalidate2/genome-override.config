/*
 * genome-override.config — run-specific override, loaded LAST (after genomes.config).
 *
 * Re-confirmed live on 2026-08-10 against nf-core/sarek 3.5.1 (previously confirmed against
 * 3.9.0 on 2026-07-29, see runs/20260729-sarek-srr26793256/genome-override.config for the full
 * writeup of the underlying sarek behavior). Still required: without this, `--genome GRCh38gatk`
 * makes sarek auto-populate params.bwamem2/dragmap/dbsnp/dbsnp_tbi/known_indels/known_indels_tbi
 * from genomes.config's declared-but-not-yet-fetched [!] paths, and nf-schema's exists:true then
 * fails hard on all of them regardless of --step/--tools actually needing them. Reproduced live
 * this run via `-preview` before writing this file.
 *
 * Fix: keep params.genome falsy. --fasta/--fasta_fai/--dict are passed explicitly on the CLI and
 * are unaffected (CLI-set params survive later script-level params.x = ... reassignment).
 */
params.genome = ''
