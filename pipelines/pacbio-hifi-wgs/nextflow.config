/*
 * ============================================================================
 * pacbio-hifi-wgs — PacBio HiFi human WGS germline pipeline
 *
 * subreads → [pbccs] → HiFi uBAM → [pbmm2] → aligned BAM
 *          → [DeepVariant / Clair3] SNV+indel → [WhatsHap] phase + haplotag
 *          → [pbsv] SV → QC (mosdepth, samtools, bcftools stats, MultiQC)
 *
 * Standalone by design: zero Nextflow plugins, no nf-core template machinery.
 * Copy this directory to any host with Nextflow >= 24.04 and a container
 * runtime, and run:
 *
 *   nextflow run pipelines/pacbio-hifi-wgs \
 *     -profile docker \
 *     --input samplesheet.csv --fasta ref.fa --outdir results
 *
 * Per-sample entry points (raw subreads / CLR subreads / HiFi reads / already-aligned
 * BAM) are selected per samplesheet row via the input_type column — see README.md.
 * CLR skips pbccs (it cannot be made HiFi) and carries a runtime warning.
 * ============================================================================
 */

manifest {
    name            = 'pacbio-hifi-wgs'
    author          = 'bioinfo-agent'
    description     = 'PacBio HiFi human WGS: CCS, pbmm2, DeepVariant, Clair3, WhatsHap, pbsv'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    // ---- required ----
    input                 = null      // samplesheet CSV: sample,dataset,input_type,file[,index]
    fasta                 = null      // reference FASTA (uncompressed)
    outdir                = 'results'

    // ---- output layout ----
    // results/<sample>/<platform_subdir>/<dataset>/{01_HIFI,02_alignedBAM,03_VCF,04_QC}
    platform_subdir       = 'PacBio'
    ref_name              = null      // used in output filenames; default = fasta basename

    // ---- step toggles ----
    skip_deepvariant      = false
    skip_clair3           = false
    skip_pbsv             = false
    skip_phasing          = false     // WhatsHap phase + haplotag
    skip_qc               = false     // mosdepth/samtools/bcftools stats + MultiQC
    gvcf                  = false     // also emit gVCF from DeepVariant

    // ---- CCS (HiFi generation from subreads) ----
    ccs_chunks            = 8         // parallel chunks per movie (needs .pbi; made if absent)
    ccs_args              = ''        // extra args, e.g. '--min-rq 0.99'

    // ---- pbmm2 ----
    pbmm2_preset          = 'CCS'     // CCS == HiFi preset
    pbmm2_clr_preset      = 'SUBREAD' // used only for clr_subreads rows — CLR is not HiFi and
                                      // must not be aligned with the CCS preset
    pbmm2_args            = ''

    // ---- DeepVariant ----
    deepvariant_model     = 'PACBIO'
    deepvariant_args      = ''

    // ---- Clair3 ----
    clair3_platform       = 'hifi'
    clair3_model          = 'hifi_revio'  // /opt/models dir: hifi_revio (Revio, m84* movies)
                                          // | hifi_sequel2 (Sequel II, m64*) | hifi (legacy generic)
                                          // WRONG MODEL STILL RUNS — set per dataset, see README
    clair3_args           = ''        // e.g. '--include_all_ctgs'

    // ---- WhatsHap ----
    phase_vcf             = 'deepvariant'   // which small-variant VCF to phase: deepvariant | clair3
    whatshap_args         = ''

    // ---- pbsv ----
    pbsv_tandem_repeats   = null      // optional TRF bed for pbsv discover
    pbsv_discover_args    = ''
    pbsv_call_args        = ''

    // ---- SGE (only used by -profile sge) ----
    sge_queue             = null      // e.g. 'all.q'
    sge_pe                = 'smp'     // parallel environment name; check with `qconf -spl`
    sge_options           = ''        // extra native qsub flags, e.g. '-l h_vmem=4G'

    // ---- containers (override any of these to pin a different version) ----
    // Tags verified against quay.io / Docker Hub registry APIs on 2026-08-20.
    container_pbccs       = 'quay.io/biocontainers/pbccs:6.4.0--h9ee0642_0'     // final ccs release; Revio does CCS on-instrument
    container_pbtk        = 'quay.io/biocontainers/pbtk:3.5.0--h9ee0642_0'      // pbindex + pbmerge
    container_pbmm2       = 'quay.io/biocontainers/pbmm2:26.2.0--h9ee0642_0'    // calendar versioning since 2026 (1.17.0 -> 26.x)
    container_pbsv        = 'quay.io/biocontainers/pbsv:2.11.0--h9ee0642_0'
    container_whatshap    = 'quay.io/biocontainers/whatshap:2.8--py312hf731ba3_0'
    container_samtools    = 'quay.io/biocontainers/samtools:1.24--h9dcdb79_1'
    container_bcftools    = 'quay.io/biocontainers/bcftools:1.24--h118bc1c_2'
    container_mosdepth    = 'quay.io/biocontainers/mosdepth:0.3.14--h05c3d44_1'
    container_multiqc     = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1'
    container_deepvariant = 'google/deepvariant:1.10.0'
    container_clair3      = 'hkubal/clair3:v1.2.0'   // v2.x images dropped ALL HiFi models
                                                     // (verified 2026-08-20: v2.0.2 /opt/models has ilmn/ont only;
                                                     //  v1.2.0 bundles hifi, hifi_revio, hifi_sequel2)
}

// ---------------------------------------------------------------------------
// Process resources. Sized for a ~64 GB single node; on smaller hosts pass a
// -c with process.resourceLimits (Nextflow >= 24.04) to clamp, e.g. the
// bioinfo-agent repo's config/local.config.
// ---------------------------------------------------------------------------
process {
    // Integer.MAX_VALUE: SGE h_vmem/h_rss kills can take the wrapper down before the
    // exit code is written, which Nextflow reports as "terminated for an unknown reason"
    errorStrategy = { (task.exitStatus in [137, 140, 143, 104, 134, 139] || task.exitStatus == Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 1

    cpus   = 1
    memory = 2.GB
    time   = 4.h

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = 8.h
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 12.GB * task.attempt }
        time   = 16.h
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = 48.h
    }

    // pbsv discover is single-threaded (no -j flag); call is the memory hog —
    // PacBio's own WDL provisions 64 GB for unsharded human WGS pbsv call
    withName: PBSV_DISCOVER {
        cpus   = 1
        memory = { 8.GB * task.attempt }
    }
    withName: PBSV_CALL {
        memory = { 64.GB * task.attempt }
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        // Offline clusters: pre-pull images on a node with egress and set
        // NXF_SINGULARITY_CACHEDIR before launching. See README §server.
    }

    // SGE executor. Combine with a container profile: -profile sge,singularity
    sge {
        process.executor       = 'sge'
        process.penv           = params.sge_pe
        process.queue          = params.sge_queue
        process.clusterOptions = params.sge_options
    }

    // Mechanical smoke test: real PacBio subreads (nf-core isoseq CI subset,
    // fetched over https) through CCS + pbmm2 only. See assets/samplesheet.test.csv
    test {
        params.input            = "${projectDir}/assets/samplesheet.test.csv"
        params.fasta            = 'https://raw.githubusercontent.com/nf-core/test-datasets/isoseq/reference/Homo_sapiens.GRCh38.dna.chromosome.19.fasta'
        params.ref_name         = 'chr19'
        params.skip_deepvariant = true
        params.skip_clair3      = true
        params.skip_pbsv        = true
        params.skip_phasing     = true
        params.ccs_chunks       = 2
    }
}

// ---------------------------------------------------------------------------
// Run reports
// ---------------------------------------------------------------------------
def trace_ts = new java.util.Date().format('yyyyMMdd-HHmmss')

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline-${trace_ts}.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report-${trace_ts}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace-${trace_ts}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag-${trace_ts}.html"
    overwrite = true
}
