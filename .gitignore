# This repo is text only: scripts, configs, knowledge. Nothing generated, nothing large.
# If you are about to `git add -f` something, ask why it is not reconstructible from
# config/refs.manifest.tsv or a bootstrap script instead.

# ---------------------------------------------------------------- Nextflow run state
.nextflow
.nextflow.log
.nextflow.log.*
.nextflow.pid
.nextflow/
work/
**/work/
.nf-test/
.nf-test.log
timeline*.html
report*.html
trace*.txt
dag*.html
dag*.svg
dag*.mmd
pipeline_info/
**/pipeline_info/
.nextflow.history

# ---------------------------------------------------------------------- run outputs
# runs/ holds one directory per analysis. The plan and the handoff note are worth
# keeping; nothing else in there is. The `!runs/*/` line is load-bearing: git will not
# descend into an excluded directory, so the re-includes below it never fire without it.
runs/**
!runs/*/
!runs/.gitkeep
!runs/**/*.plan.md
!runs/**/handoff.md
results/
**/results/
outdir/
**/outdir/

# ------------------------------------------------------- materialised reference store
# /refs is rebuilt by bootstrap/04-refs.sh from the manifest. The manifest is the
# artifact; the bytes are not.
refs/
/refs
.refs/
genomes/
igenomes/
singularity/
.singularity/
containers/
*.sif
*.simg

